prefix=@CMAKE_INSTALL_PREFIX@
libdir=@KATHERINE_PC_LIBDIR@
includedir=@KATHERINE_PC_INCLUDEDIR@

Name: katherine
Description: Control library for the Katherine DAQ system
Version: @PROJECT_VERSION@

Requires:
Libs: -L${libdir} -lkatherine
Cflags: -I${includedir}
