#pragma once

/**
 * \defgroup katherine_features Features
 * \ingroup katherine_c_api
 * \brief What the library was configured to include.
 */

/**
 * \addtogroup katherine_features
 * \{
 */

// Generated from features.h.in, so a header can tell what the library behind
// it was built with. Every configure-time feature defines a
// KATHERINE_FEATURE_* macro here rather than on the compiler's command line,
// which is what lets a consumer reached through pkg-config, or through no
// build system at all, see the same declarations the library has.

/// Defined where the UDP transport was built, so that a `udp://` address opens; see katherine_device_init().
#cmakedefine KATHERINE_FEATURE_UDP

/// Defined where the USB transport was built, so that a `usb://` address opens; see katherine_device_init().
#cmakedefine KATHERINE_FEATURE_USB

/** \} */
